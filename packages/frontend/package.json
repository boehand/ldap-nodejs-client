{
  "name": "@ldap-ui/frontend",
  "version": "1.0.0",
  "description": "LDAP UI - Vue.js Frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "openapi-ts -i ../../_legacy/tests/resources/openapi.json -o src/generated --client fetch && node -e \"require('fs').writeFileSync('src/generated/sdk.gen.ts','export * from \\\"./services.gen\\\";\\n')\"",
    "dev": "run-s generate dev-only",
    "dev-only": "vite",
    "build": "run-s generate type-check build-only",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --ext .vue,.ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@headlessui/vue": "^2.1.x",
    "@heroicons/vue": "^2.2.x",
    "@vueuse/core": "11.x",
    "clsx": "^2.x",
    "pinia": "2.x",
    "vue": "3.5.x"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.50.x",
    "@tsconfig/node24": "24.x",
    "@types/node": "20.x",
    "@vitejs/plugin-vue": "5.x",
    "@vue/eslint-config-prettier": "9.x",
    "@vue/eslint-config-typescript": "13.x",
    "@vue/tsconfig": "0.7.x",
    "@vue/test-utils": "2.4.x",
    "@vitest/coverage-v8": "1.x",
    "autoprefixer": "10.x",
    "eslint": "8.x",
    "eslint-plugin-vue": "9.x",
    "npm-run-all2": "6.x",
    "postcss": "^8.x",
    "prettier": "3.x",
    "tailwindcss": "3.4.x",
    "tailwind-merge": "^2.x",
    "typescript": "5.x",
    "vite": "5.x",
    "vite-plugin-compression": "0.5.x",
    "vitest": "1.x",
    "vue-tsc": "2.x"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
