{
  "name": "@ldap-ui/backend",
  "version": "1.0.0",
  "description": "LDAP UI - Node.js Backend",
  "private": false,
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "ldap-ui": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./api": {
      "import": "./dist/api/index.js",
      "types": "./dist/api/index.d.ts"
    }
  },
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "build": "tsc && esbuild src/server.ts src/cli.ts --bundle --platform=node --format=esm --outdir=dist",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/session": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^9.0.0",
    "ldapjs": "^3.0.0",
    "pino": "^8.0.0",
    "pino-pretty": "^10.0.0",
    "dotenv": "^16.0.0",
    "crypto-js": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/ldapjs": "1.0.x",
    "@types/crypto-js": "4.x",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "esbuild": "0.20.x",
    "eslint": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "@vitest/coverage-v8": "latest"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
