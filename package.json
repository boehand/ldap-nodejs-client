{
  "name": "ldap-ui",
  "version": "1.0.0",
  "description": "A fast and versatile LDAP editor",
  "private": true,
  "type": "module",
  "license": "GPL-3.0",
  "workspaces": [
    "packages/frontend",
    "packages/backend"
  ],
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:backend": "pnpm --filter @ldap-ui/backend dev",
    "dev:frontend": "pnpm --filter @ldap-ui/frontend dev",
    "build": "pnpm -r build",
    "build:backend": "pnpm --filter @ldap-ui/backend build",
    "build:frontend": "pnpm --filter @ldap-ui/frontend build",
    "test": "pnpm -r test",
    "test:backend": "pnpm --filter @ldap-ui/backend test",
    "test:frontend": "pnpm --filter @ldap-ui/frontend test",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check"
  },
  "devDependencies": {
    "@tsconfig/node24": "latest",
    "@types/node": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
